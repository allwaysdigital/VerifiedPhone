PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/verifiedphone

# Must be the SAME Firebase project as android/app/google-services.json and
# ios/VerifiedPhone/GoogleService-Info.plist (see "project_id" in either file).
# No service account key needed — ID tokens are verified against Firebase's
# public signing keys directly (see server/src/auth/verifyFirebaseToken.ts).
FIREBASE_PROJECT_ID=verifiedphone-22f65

# Optional: external device-spec lookup for Add Purchase's IMEI-first flow
# and POST /api/device/lookup. Leave unset to run on the local Device Master
# cache + manual entry only (this is the default and works fine on its own).
#
# IMEI.info (https://dash.imei.info) is the configured default provider once
# all three vars below are set — see
# server/src/services/deviceLookup/imeiInfoProvider.ts for exactly what it
# calls and why its inner-field mapping is marked "unverified" pending a real
# account. To activate it:
#   1. Sign up at https://dash.imei.info and generate an API key.
#   2. Paste it as IMEI_API_KEY below.
#   3. Set IMEI_API_BASE_URL to https://dash.imei.info (no trailing slash).
#   4. Call GET https://dash.imei.info/api/service/services/?API_KEY=<your key>
#      to see which numeric service id actually returns device specs for
#      your plan, and set IMEI_API_SERVICE_ID to that number.
# IMEI_API_KEY=
# IMEI_API_BASE_URL=https://dash.imei.info
# IMEI_API_SERVICE_ID=

# Optional second provider option — see deviceAtlasProvider.ts; currently an
# inert stub (DeviceAtlas's public API isn't a live lookup endpoint). Only
# used as a fallback if the IMEI_API_* vars above are not set.
# DEVICE_LOOKUP_PROVIDER=deviceatlas
# DEVICEATLAS_API_KEY=
