PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/verifiedphone

# Must be the SAME Firebase project as android/app/google-services.json and
# ios/VerifiedPhone/GoogleService-Info.plist (see "project_id" in either file).
# No service account key needed — ID tokens are verified against Firebase's
# public signing keys directly (see server/src/auth/verifyFirebaseToken.ts).
FIREBASE_PROJECT_ID=verifiedphone-22f65

# Device photos, ID documents, and shop logos are uploaded to this S3 bucket
# (public-read) — see server/src/upload/s3Client.ts. The IAM user only needs
# s3:PutObject on this bucket; the bucket itself needs a public-read policy
# on GetObject (Block Public Access must be off for that policy to apply).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# 2Factor.in sends the OTP SMS during login/signup, using this DLT-approved
# template exactly as approved on the 2Factor dashboard (Templates section) —
# it must match character-for-character, typo included, or sends will fail.
# Get the API key from the 2Factor dashboard's API Keys section.
TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=VERIFIEED PHONE OTP

# Signs the app's own session tokens (see auth/appToken.ts) now that phone
# verification goes through 2Factor instead of Firebase. Generate one with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
# and never rotate it on a running server — that logs everyone out at once.
APP_JWT_SECRET=
